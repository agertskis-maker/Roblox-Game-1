{
  "name": "CarHop-Downtown-LookDev",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Packages": {
        "$path": "../Packages"
      },
      "Shared": {
        "$path": "../src/shared"
      },
      "LookDev": {
        "$path": "../src/lookdev"
      },
      "Lane3Playground": {
        "$path": "downtown/Lane3Playground.model.json"
      },
      "Lane3_DowntownCityInfo": {
        "$className": "Configuration",
        "$attributes": {
          "Kit": "B2",
          "KitFolder": "ReplicatedStorage.Lane3_DowntownKitB2 (optional: Car-Hop-Art/downtown-kit-b2/meshes; ReplicatedStorage so a Play client can read it too)",
          "KitData": "ReplicatedStorage.Lane3_DowntownKitB2Data (optional manifest.json, swatches.json)",
          "Entry": "require(game.ReplicatedStorage.LookDev.Downtown.City).run({ seed = 2207, length = 2400 })",
          "Note": "Lane 3 Downtown B city preview marker. Playground only; default.project.json never maps it."
        }
      },
      "LookDevCars": {
        "$className": "Folder",
        "Fixtures": {
          "$path": "../src/client/UI/Prototype/Fixtures.luau"
        },
        "ProxyCar": {
          "$path": "../src/client/UI/Prototype/ProxyCar.luau"
        }
      },
      "Lane3_DowntownKitB2": {
        "$path": {
          "optional": "../../Car-Hop-Art/downtown-kit-b2/meshes"
        }
      },
      "Lane3_DowntownKitB2Data": {
        "$className": "Folder",
        "manifest": {
          "$path": {
            "optional": "../../Car-Hop-Art/downtown-kit-b2/manifest.json"
          }
        },
        "swatches": {
          "$path": {
            "optional": "../../Car-Hop-Art/downtown-kit-b2/swatches.json"
          }
        }
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "Lane3_DowntownKit": {
        "$path": {
          "optional": "../../Car-Hop-Art/downtown-kit/meshes"
        }
      },
      "Lane3_DowntownLayouts": {
        "$className": "Folder",
        "layout-A": {
          "$path": {
            "optional": "../../Car-Hop-Art/downtown-kit/layout-A.json"
          }
        },
        "layout-B": {
          "$path": {
            "optional": "../../Car-Hop-Art/downtown-kit/layout-B.json"
          }
        },
        "layout-C": {
          "$path": {
            "optional": "../../Car-Hop-Art/downtown-kit/layout-C.json"
          }
        },
        "swatches": {
          "$path": {
            "optional": "../../Car-Hop-Art/downtown-kit/swatches.json"
          }
        },
        "manifest": {
          "$path": {
            "optional": "../../Car-Hop-Art/downtown-kit/manifest.json"
          }
        }
      }
    },
    "Players": {
      "$className": "Players",
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "LookDev": {
          "$path": "downtown/scripts"
        }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "FilteringEnabled": true
      }
    },
    "StarterGui": {
      "$className": "StarterGui",
      "$properties": {
        "ScreenOrientation": "LandscapeSensor"
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "ShadowMap"
      }
    }
  }
}

    <Item class="Highlight" referent="13">
      <Properties>
        <string name="Name">RainbowShimmer</string>
        <Ref name="Adornee">2</Ref>
        <BinaryString name="AttributesSerialize"></BinaryString>
        <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
        <token name="DepthMode">1</token>
        <bool name="Enabled">true</bool>
        <Color3 name="FillColor">
          <R>1</R>
          <G>0.47058824</G>
          <B>0.8627451</B>
        </Color3>
        <float name="FillTransparency">0.85</float>
        <Color3 name="OutlineColor">
          <R>0.5882353</R>
          <G>0.9019608</G>
          <B>1</B>
        </Color3>
        <float name="OutlineTransparency">0.55</float>
        <bool name="DefinesCapabilities">false</bool>

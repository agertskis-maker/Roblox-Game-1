    </Item>
    <Item class="Script" referent="14">
      <Properties>
        <string name="Name">RainbowFlowScript</string>
        <BinaryString name="AttributesSerialize"></BinaryString>
        <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
        <bool name="Disabled">false</bool>
        <ContentId name="LinkedSource">
          <null>
          </null>
        </ContentId>
        <token name="RunContext">2</token>
        <bool name="DefinesCapabilities">false</bool>
        <BinaryString name="SerializedOverrides">
        </BinaryString>
        <string name="Source"><![CDATA[--!strict
-- Rainbow Variant shimmer for a showroom car. Client RunContext, so it runs on each player's
-- machine and only while the car is somewhere in Workspace (copies kept in ReplicatedStorage.Cars
-- stay idle). With Roblox's Reduce Motion setting on, the colours hold still.

local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Trove = require(ReplicatedStorage:WaitForChild("Packages"):WaitForChild("Trove"))

local model = script.Parent :: Model
local highlight = model:FindFirstChild("RainbowShimmer") :: Highlight?

local lights: { PointLight } = {}
for _, d in model:GetDescendants() do
	if d:IsA("PointLight") and d.Name == "RainbowGlow" then
		table.insert(lights, d)
	end
end

local function paint(t: number)
	local c = Color3.fromHSV((t * 0.18) % 1, 0.85, 1)
	if highlight then
		highlight.FillColor = c
		highlight.FillTransparency = 0.82 + 0.06 * math.sin(t * 2.2)
		highlight.OutlineColor = Color3.fromHSV((t * 0.18 + 0.5) % 1, 0.6, 1)
	end
	for _, l in lights do
		l.Color = c
	end
end

local trove = Trove.new()
local t = math.random() * 10

local function refresh()
	trove:Clean()
	if not model:IsDescendantOf(workspace) then
		return
	end
	paint(t)
	if GuiService.ReducedMotionEnabled then
		return
	end
	trove:Connect(RunService.Heartbeat, function(dt: number)
		t += dt
		paint(t)
	end)
end

model.AncestryChanged:Connect(refresh)
GuiService:GetPropertyChangedSignal("ReducedMotionEnabled"):Connect(refresh)
model.Destroying:Connect(function()
	trove:Destroy()
end)
refresh()
]]></string>
        <int64 name="SourceAssetId">-1</int64>
        <BinaryString name="Tags"></BinaryString>
      </Properties>
    </Item>
  </Item>
  <SharedStrings>

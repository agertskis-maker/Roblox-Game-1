# --- Rojo ---
# Build outputs (rojo build -o game.rbxl)
*.rbxl
*.rbxlx
*.rbxl.lock
*.rbxm
*.rbxmx
# Generated by `rojo sourcemap` for luau-lsp
sourcemap.json
# Selene's generated Roblox API standard library.
/roblox.yml

# --- Wally ---
# Installed packages are generated by `wally install`; wally.lock IS committed.
/Packages/
/ServerPackages/
/DevPackages/

# --- Obsidian ---
# Per-user UI state; shared vault config (plugins, hotkeys) stays tracked.
vault/.obsidian/workspace.json
vault/.obsidian/workspace-mobile.json
vault/.obsidian/graph.json
vault/.obsidian/cache
vault/.trash/

# Machine-local AI settings are not shared.
.claude/settings.local.json

# Playwright MCP browser-tool output (local only).
/.playwright-mcp/

# Python bytecode from the Blender kit build
__pycache__/
